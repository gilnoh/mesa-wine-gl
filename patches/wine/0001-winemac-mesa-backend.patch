+typedef mesa_wine_ctx_t    (*pfn_mesa_wine_create_context)(mesa_wine_screen_t, int, int, int, int, unsigned, mesa_wine_ctx_t);
+typedef void               (*pfn_mesa_wine_destroy_context)(mesa_wine_ctx_t);
