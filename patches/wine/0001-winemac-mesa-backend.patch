+/* ================================================================
+ *  Context management
+ * ================================================================ */
+
+static BOOL macdrv_context_create(int format, void *shared, const int *attrib_list, void **private)
+{
+    struct mesa_context *share_context = shared;
+    struct mesa_context *context;
+    const int *iptr;
+    int major = 1, minor = 0, profile = MESA_WINE_PROFILE_COMPAT, flags = 0;
+
+    TRACE("format %d, share_context %p, attrib_list %p\n", format, share_context, attrib_list);
+
+    for (iptr = attrib_list; iptr && *iptr; iptr += 2)
+    {
+        int attr = iptr[0];
+        int value = iptr[1];
+
+        switch (attr)
+        {
+            case WGL_CONTEXT_MAJOR_VERSION_ARB:
+                major = value;
+                break;
+            case WGL_CONTEXT_MINOR_VERSION_ARB:
+                minor = value;
+                break;
+            case WGL_CONTEXT_LAYER_PLANE_ARB:
+                break;
+            case WGL_CONTEXT_FLAGS_ARB:
+                if (value & WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB)
+                    flags |= MESA_WINE_FLAG_FORWARD_COMPATIBLE;
+                if (value & WGL_CONTEXT_DEBUG_BIT_ARB)
+                    flags |= MESA_WINE_FLAG_DEBUG;
+                break;
+            case WGL_CONTEXT_PROFILE_MASK_ARB:
+                if (value == WGL_CONTEXT_CORE_PROFILE_BIT_ARB)
+                    profile = MESA_WINE_PROFILE_CORE;
+                else
+                    profile = MESA_WINE_PROFILE_COMPAT;
+                break;
+            default:
+                WARN("Unknown attribute %#x.\n", attr);
+                break;
+        }
+    }
+
+    if (!(context = calloc(1, sizeof(*context)))) return FALSE;
+
+    context->format = format;
+    context->mesa_ctx = mesa.create_context(
+        mesa_screen, format, major, minor, profile, flags,
+        share_context ? share_context->mesa_ctx : NULL);
+
+    if (!context->mesa_ctx)
+    {
+        ERR("Mesa context creation failed (GL %d.%d)\n", major, minor);
+        free(context);
+        RtlSetLastWin32Error(ERROR_INVALID_OPERATION);
+        return FALSE;
+    }
+
+    TRACE("Created Mesa context %p (GL %d.%d %s)\n", context->mesa_ctx,
+          major, minor, profile == MESA_WINE_PROFILE_CORE ? "core" : "compat");
+
+    *private = context;
+    return TRUE;
+}
+
+static BOOL macdrv_context_destroy(void *private)
+{
+    struct mesa_context *context = private;
+
+    TRACE("context %p\n", context);
+
+    if (context->mesa_ctx)
+        mesa.destroy_context(context->mesa_ctx);
+
+    free(context);
+    return TRUE;
+}
+
+static BOOL macdrv_make_current(struct opengl_drawable *draw_base, struct opengl_drawable *read_base, void *private)
+{
+    struct mesa_context *context = private;
+
+    TRACE("draw %s, read %s, context %p\n",
+          debugstr_opengl_drawable(draw_base), debugstr_opengl_drawable(read_base), private);
+
+    if (!private)
+    {
+        mesa.make_current(NULL, NULL, NULL);
+        NtCurrentTeb()->glReserved2 = NULL;
+        return TRUE;
+    }
+
+    {
+        struct gl_drawable *draw = impl_from_opengl_drawable(draw_base);
+        struct gl_drawable *read = impl_from_opengl_drawable(read_base);
+
+        if (!mesa.make_current(context->mesa_ctx, draw->mesa_draw, read->mesa_draw))
+        {
+            ERR("mesa_wine_make_current failed\n");
+            return FALSE;
+        }
+    }
+
+    NtCurrentTeb()->glReserved2 = context;
+    return TRUE;
+}
