+/* ================================================================
+ *  Pixel formats — hardcoded for now
+ *
+ *  We provide a minimal set of pixel formats that cover common usage.
+ *  Format 1: RGBA8 double-buffered with depth24/stencil8 (onscreen)
+ *  Format 2: RGBA8 single-buffered with depth24/stencil8 (onscreen)
+ *  Format 3: RGBA8 double-buffered with depth24/stencil8 (pbuffer)
+ * ================================================================ */
+
+static int total_pixel_formats = 0;
+static int onscreen_pixel_formats = 0;
+
+static UINT macdrv_init_pixel_formats(UINT *onscreen_count)
+{
+    TRACE("()\n");
+
+    total_pixel_formats = mesa.get_pixel_format_count(mesa_screen, &onscreen_pixel_formats);
+    *onscreen_count = onscreen_pixel_formats;
+
+    TRACE("Mesa enumerated %d pixel formats (%d onscreen)\n",
+          total_pixel_formats, onscreen_pixel_formats);
+
+    return total_pixel_formats;
+}
+
+static BOOL macdrv_describe_pixel_format(int fmt, struct wgl_pixel_format *descr)
+{
+    struct mesa_wine_pixel_format_info info;
+
+    TRACE("fmt %d\n", fmt);
+
+    if (!mesa.get_pixel_format_info(mesa_screen, fmt, &info))
+        return FALSE;
+
+    memset(descr, 0, sizeof(*descr));
+
+    descr->pfd.nSize = sizeof(descr->pfd);
+    descr->pfd.nVersion = 1;
+    descr->pfd.dwFlags = PFD_SUPPORT_OPENGL;
+    descr->pfd.iPixelType = PFD_TYPE_RGBA;
+    descr->pfd.iLayerType = PFD_MAIN_PLANE;
+
+    if (info.pbuffer)
+        descr->pfd.dwFlags |= PFD_DRAW_TO_BITMAP;
+    else
+        descr->pfd.dwFlags |= PFD_DRAW_TO_WINDOW;
+
+    if (info.doublebuffer)
+    {
+        descr->pfd.dwFlags |= PFD_DOUBLEBUFFER;
+        descr->swap_method = WGL_SWAP_UNDEFINED_ARB;
+    }
+
+    /* Color */
+    descr->pfd.cColorBits = info.color_bits;
+    descr->pfd.cRedBits = info.red_bits;     descr->pfd.cRedShift = info.red_shift;
+    descr->pfd.cGreenBits = info.green_bits;  descr->pfd.cGreenShift = info.green_shift;
+    descr->pfd.cBlueBits = info.blue_bits;    descr->pfd.cBlueShift = info.blue_shift;
+    descr->pfd.cAlphaBits = info.alpha_bits;  descr->pfd.cAlphaShift = info.alpha_shift;
+
+    /* Depth/stencil */
+    descr->pfd.cDepthBits = info.depth_bits;
+    descr->pfd.cStencilBits = info.stencil_bits;
+
+    /* WGL attributes — pixel_type must be set for client-side caching */
+    descr->pixel_type = info.float_components ? WGL_TYPE_RGBA_FLOAT_ARB : WGL_TYPE_RGBA_ARB;
+    descr->framebuffer_srgb_capable = info.srgb ? GL_TRUE : GL_FALSE;
+
+    /* MSAA */
+    if (info.samples > 0)
+    {
+        descr->sample_buffers = 1;
+        descr->samples = info.samples;
+    }
+
+    /* Pbuffer caps */
+    if (info.pbuffer)
+    {
+        descr->draw_to_pbuffer = GL_TRUE;
+        descr->max_pbuffer_width = 4096;
+        descr->max_pbuffer_height = 4096;
+        descr->max_pbuffer_pixels = 4096 * 4096;
+        descr->bind_to_texture_rgb = GL_TRUE;
+        descr->bind_to_texture_rgba = GL_TRUE;
+        descr->bind_to_texture_rectangle_rgb = GL_TRUE;
+        descr->bind_to_texture_rectangle_rgba = GL_TRUE;
+    }
+
+    return TRUE;
+}
