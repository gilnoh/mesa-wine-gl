+/* ================================================================
+ *  Initialization
+ * ================================================================ */
+
+static BOOL load_mesa_bridge(void)
+{
+    const char *lib_path = getenv("MESA_WINE_LIB");
+    if (!lib_path || !*lib_path) return FALSE;
+
+    mesa.handle = dlopen(lib_path, RTLD_NOW | RTLD_LOCAL);
+    if (!mesa.handle)
+    {
+        ERR("Failed to load Mesa bridge library '%s': %s\n", lib_path, dlerror());
+        return FALSE;
+    }
+
+    unsigned (*get_abi)(void) = dlsym(mesa.handle, "mesa_wine_get_abi_version");
+    if (!get_abi || get_abi() != MESA_WINE_ABI_VERSION) {
+        ERR("Mesa bridge ABI mismatch\n"); goto fail;
+    }
+
+#define LOAD_FUNC(name) \
+    mesa.name = dlsym(mesa.handle, "mesa_wine_" #name); \
+    if (!mesa.name) { ERR("Missing symbol mesa_wine_" #name " in %s\n", lib_path); goto fail; }
+
+    LOAD_FUNC(init);
+    LOAD_FUNC(fini);
+    LOAD_FUNC(get_pixel_format_count);
+    LOAD_FUNC(get_pixel_format_info);
+    LOAD_FUNC(create_context);
+    LOAD_FUNC(destroy_context);
+    LOAD_FUNC(create_drawable);
+    LOAD_FUNC(destroy_drawable);
+    LOAD_FUNC(resize_drawable);
+    LOAD_FUNC(make_current);
+    LOAD_FUNC(get_proc_address);
+    LOAD_FUNC(flush);
+    LOAD_FUNC(swap_buffers);
+    LOAD_FUNC(attach_presentation);
+    LOAD_FUNC(detach_presentation);
+
+#undef LOAD_FUNC
+
+    return TRUE;
+
+fail:
+    dlclose(mesa.handle);
+    mesa.handle = NULL;
+    return FALSE;
+}
