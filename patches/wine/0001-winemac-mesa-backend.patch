+/* ================================================================
+ *  Surface (drawable) management
+ * ================================================================ */
+
+static BOOL macdrv_surface_create(HWND hwnd, int format, struct opengl_drawable **drawable)
+{
+    struct macdrv_client_surface *client;
+    struct macdrv_win_data *data;
+    struct gl_drawable *gl;
+
+    TRACE("hwnd %p, format %d, drawable %p\n", hwnd, format, drawable);
+
+    if (!(data = get_win_data(hwnd)))
+    {
+        FIXME("DC for window %p of other process: not implemented\n", hwnd);
+        return FALSE;
+    }
+
+    data->pixel_format = format;
+    {
+        int w = data->rects.client.right - data->rects.client.left;
+        int h = data->rects.client.bottom - data->rects.client.top;
+        if (w <= 0) w = 1;
+        if (h <= 0) h = 1;
+        release_win_data(data);
+
+        if (!(client = macdrv_client_surface_create(hwnd))) return FALSE;
+
+        /* Set up Metal presentation before releasing client reference.
+         * We need client->cocoa_view to create the Metal view. */
+        gl = opengl_drawable_create(sizeof(*gl), &macdrv_surface_funcs, format, &client->client);
+        if (!gl)
+        {
+            client_surface_release(&client->client);
+            return FALSE;
+        }
+
+        gl->metal_device = macdrv_create_metal_device();
+        if (gl->metal_device)
+        {
+            gl->metal_view = macdrv_view_create_metal_view(client->cocoa_view, gl->metal_device);
+            if (!gl->metal_view)
+                WARN("Failed to create Metal view for presentation\n");
+        }
+        else
+            WARN("Failed to create Metal device for presentation\n");
+
+        client_surface_release(&client->client);
+        if (!gl->metal_view) { opengl_drawable_release(&gl->base); return FALSE; }
+
+        /* Create Mesa drawable sized to the window's client area */
+        gl->mesa_draw = mesa.create_drawable(mesa_screen, format, w, h);
+        if (!gl->mesa_draw)
+        {
+            WARN("Failed to create Mesa drawable\n");
+            opengl_drawable_release(&gl->base);
+            return FALSE;
+        }
+
+        /* Attach Vulkan swapchain to the drawable for on-screen display */
+        if (gl->metal_view)
+        {
+            void *metal_layer = (void *)macdrv_view_get_metal_layer(gl->metal_view);
+            if (!mesa.attach_presentation(mesa_screen, gl->mesa_draw, metal_layer))
+            {
+                ERR("Failed to attach presentation\n");
+                opengl_drawable_release(&gl->base);
+                return FALSE;
+            }
+            else
+                TRACE("Presentation attached for hwnd %p\n", hwnd);
+        }
+    }
+
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+static void macdrv_surface_destroy(struct opengl_drawable *base)
+{
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+
+    if (gl->mesa_draw)
+    {
+        mesa.detach_presentation(gl->mesa_draw);
+        mesa.destroy_drawable(gl->mesa_draw);
+    }
+
+    if (gl->metal_view)
+        macdrv_view_release_metal_view(gl->metal_view);
+    if (gl->metal_device) macdrv_release_metal_device(gl->metal_device);
+}
+
+static void macdrv_surface_check_resize(struct opengl_drawable *base);
+
+static void macdrv_surface_flush(struct opengl_drawable *base, UINT flags)
+{
+    TRACE("%s flags %#x\n", debugstr_opengl_drawable(base), flags);
+
+    if (flags & GL_FLUSH_UPDATED) macdrv_surface_check_resize(base);
+    if (flags & GL_FLUSH_PRESENT) mesa.flush();
+}
+
+static void macdrv_surface_check_resize(struct opengl_drawable *base)
+{
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
+    struct macdrv_win_data *data;
+
+    if (!base->client)
+        return;
+
+    if (!(data = get_win_data(base->client->hwnd)))
+        return;
+
+    {
+        int w = data->rects.client.right - data->rects.client.left;
+        int h = data->rects.client.bottom - data->rects.client.top;
+        release_win_data(data);
+        if (w <= 0) w = 1;
+        if (h <= 0) h = 1;
+
+        mesa.resize_drawable(gl->mesa_draw, w, h);
+    }
+}
+
+static BOOL macdrv_surface_swap(struct opengl_drawable *base)
+{
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("%s\n", debugstr_opengl_drawable(base));
+
+    return mesa.swap_buffers(gl->mesa_draw);
+}
+
+static void macdrv_surface_set_context(struct opengl_drawable *base, void *private)
+{
+    TRACE("%s, context %p\n", debugstr_opengl_drawable(base), private);
+
+    macdrv_surface_check_resize(base);
+}
