+/* Development-only GS XFB path; see XFB_GS_PROBE. Counter handling follows
+ * the common poly frontend model (GPU offsets, including pause/resume). */
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
+                                      uint32_t firstBinding, uint32_t bindingCount,
+                                      const VkBuffer *buffers,
+                                      const VkDeviceSize *offsets,
+                                      const VkDeviceSize *sizes)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   for (unsigned i = 0; i < bindingCount; ++i) {
+      VK_FROM_HANDLE(kk_buffer, buffer, buffers[i]);
+      cmd->state.gfx.xfb[firstBinding+i] = kk_buffer_addr_range(
+         buffer, offsets[i], sizes ? sizes[i] : VK_WHOLE_SIZE);
+   }
+}
+
+static void
+kk_xfb_begin_end(struct kk_cmd_buffer *cmd, uint32_t first, uint32_t count,
+                 const VkBuffer *buffers, const VkDeviceSize *offsets, bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   if (!gfx->xfb_offsets)
+      gfx->xfb_offsets = kk_pool_alloc(cmd, 16, 4).gpu;
+   for (unsigned i = 0; i < 4; ++i) {
+      uint64_t external = 0;
+      if (buffers && i >= first && i-first < count && buffers[i-first]) {
+         VK_FROM_HANDLE(kk_buffer, buffer, buffers[i-first]);
+         external = vk_buffer_address(&buffer->vk, offsets ? offsets[i-first] : 0);
+      }
+      uint64_t internal = gfx->xfb_offsets + i*4;
+      if (begin || external)
+         libkk_copy_xfb_counter(cmd, kk_grid_1d(1), true,
+                                begin ? internal : external,
+                                begin ? external : internal);
+   }
+   gfx->xfb_enabled = begin;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedbackEXT(VkCommandBuffer commandBuffer, uint32_t first,
+                                uint32_t count, const VkBuffer *buffers,
+                                const VkDeviceSize *offsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_xfb_begin_end(cmd, first, count, buffers, offsets, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedbackEXT(VkCommandBuffer commandBuffer, uint32_t first,
+                              uint32_t count, const VkBuffer *buffers,
+                              const VkDeviceSize *offsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_xfb_begin_end(cmd, first, count, buffers, offsets, false);
+}
