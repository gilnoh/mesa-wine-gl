+/* Poly pads variable-length GS draws with restart indices. Metal can invoke
+ * a point-list vertex shader for those indices; they must not write XFB data. */
+static bool
+kk_guard_gs_restart_writes(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_global)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_push_if(b, nir_ine_imm(b, nir_load_vertex_id(b), UINT32_MAX));
+   nir_instr_remove(&intr->instr);
+   nir_builder_instr_insert(b, &intr->instr);
+   nir_pop_if(b, NULL);
+   return true;
+}
