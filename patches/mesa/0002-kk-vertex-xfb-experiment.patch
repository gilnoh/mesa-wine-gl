+/* Reuse poly's primitive-ordered capture path for a pipeline without an
+ * application GS. The experiment accepts fixed point, line and triangle topologies. */
+static nir_shader *
+kk_xfb_passthrough(nir_shader *vs, enum mesa_prim prim)
+{
+   size_t key_size = poly_passthrough_gs_key_size(vs->xfb_info->output_count);
+   struct poly_passthrough_gs_key *key = rzalloc_size(NULL, key_size);
+   key->prim = u_decomposed_prim(prim);
+   key->outputs = vs->info.outputs_written;
+   key->clip_distance_array_size = vs->info.clip_distance_array_size;
+   key->cull_distance_array_size = vs->info.cull_distance_array_size;
+   memcpy(key->xfb_stride, vs->info.xfb_stride, sizeof(key->xfb_stride));
+   memcpy(&key->xfb_info, vs->xfb_info,
+          nir_xfb_info_size(vs->xfb_info->output_count));
+
+   nir_foreach_function_impl(impl, vs) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_store_output)
+               continue;
+            unsigned loc = nir_intrinsic_io_semantics(intr).location;
+            key->output_types[loc] = nir_intrinsic_src_type(intr);
+            key->output_components[loc] = MAX2(key->output_components[loc],
+               nir_intrinsic_component(intr) + intr->num_components);
+         }
+      }
+   }
+
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_GEOMETRY,
+                                                 &kk_nir_options, "xfb passthrough");
+   poly_nir_passthrough_gs(&b, key);
+   b.shader->info.io_lowered = true;
+   b.shader->info.next_stage = MESA_SHADER_FRAGMENT;
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   ralloc_free(key);
+   ralloc_free(vs->xfb_info);
+   vs->xfb_info = NULL;
+   vs->info.has_transform_feedback_varyings = false;
+   memset(vs->info.xfb_stride, 0, sizeof(vs->info.xfb_stride));
+   return b.shader;
+}
