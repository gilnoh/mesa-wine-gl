#!/usr/bin/env python3
"""Build only experimental KK, checking exact equality with the declared patch series."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

root=Path(__file__).resolve().parent.parent
source=root/'src/mesa-xfb'
build=root/'build/kk-xfb-x86_64'
env=os.environ.copy()
for key in ('CPATH','C_INCLUDE_PATH','CPLUS_INCLUDE_PATH','OBJC_INCLUDE_PATH','LIBRARY_PATH',
            'CFLAGS','CXXFLAGS','OBJCFLAGS','CPPFLAGS','LDFLAGS'):
    env.pop(key,None)
env['PATH']=f'{root}/toolchains/python-x86_64/bin:/usr/local/opt/llvm/bin:/usr/local/opt/bison/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin'
env['SDKROOT']=subprocess.check_output(['xcrun','--sdk','macosx','--show-sdk-path'],text=True).strip()
env['MACOSX_DEPLOYMENT_TARGET']='26.0'
env['PKG_CONFIG_LIBDIR']='/usr/local/lib/pkgconfig:/usr/local/share/pkgconfig'
env['PKG_CONFIG_PATH']='/usr/local/opt/llvm/lib/pkgconfig:/usr/local/opt/spirv-llvm-translator/lib/pkgconfig:/usr/local/opt/spirv-tools/lib/pkgconfig:/usr/local/opt/libclc/share/pkgconfig'
pin=json.loads((root/'sources.lock.json').read_text())['mesa']['commit']
if subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],text=True).strip()!=pin:
    raise SystemExit('Experiment source revision differs from sources.lock.json')
with tempfile.TemporaryDirectory() as temp:
    verify=env|{'GIT_INDEX_FILE':str(Path(temp)/'index')}
    def git(*args):
        return subprocess.run(['git','-C',str(source),*args],env=verify,check=True)
    git('read-tree',pin)
    for line in (root/'patches/series').read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):continue
        kind,name=line.split()
        if kind!='experimental':raise SystemExit(f'Unknown patch class: {kind}')
        git('apply','--cached',str(root/'patches'/name))
    git('diff','--exit-code','--no-ext-diff')
    extra=subprocess.check_output(['git','-C',str(source),'ls-files','--others','--exclude-standard'],env=verify,text=True)
    if extra:raise SystemExit('Unexpected source files: '+extra)
if '--verify-only' in sys.argv:
    print('Source matches the pinned revision plus patches/series exactly')
    raise SystemExit(0)
args=[str(root/'toolchains/python-x86_64/bin/meson'),'setup',str(build),str(source),
      '--native-file',str(root/'config/mesa-x86_64.ini'),'--buildtype','debugoptimized','-Db_ndebug=false',
      '-Dplatforms=macos','-Dgallium-drivers=','-Dvulkan-drivers=kosmickrisp',
      '-Dopengl=false','-Dglx=disabled','-Degl=disabled','-Dgbm=disabled',
      '-Dllvm=enabled','-Dzstd=enabled','-Dtools=']
if (build/'build.ninja').exists():args+=['--reconfigure']
with (root/'build/kk-experiment-configure.log').open('w') as log:
    subprocess.run(['/usr/bin/arch','-x86_64',*args],env=env,stdout=log,stderr=subprocess.STDOUT,check=True)
with (root/'build/kk-experiment-build.log').open('w') as log:
    subprocess.run(['ninja','-C',str(build),'-j',env.get('JOBS','6')],env=env,stdout=log,stderr=subprocess.STDOUT,check=True)
print(build/'src/kosmickrisp/vulkan/kosmickrisp_mesa_devenv_icd.x86_64.json')
