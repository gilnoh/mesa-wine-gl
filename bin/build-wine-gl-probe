#!/usr/bin/env python3
"""Build the Windows WGL window probe; record binary/source hashes."""
import hashlib, json, shutil, subprocess
from pathlib import Path
root=Path(__file__).resolve().parent.parent
source=root/'probes/wine-gl-window.c'; output=root/'build/wine-gl-window.exe'
cc=shutil.which('x86_64-w64-mingw32-gcc')
if not cc: raise SystemExit('x86_64-w64-mingw32-gcc is required')
subprocess.run([cc,'-O2','-Wall','-Werror',str(source),'-o',str(output),'-lopengl32','-lgdi32','-luser32'],check=True)
manifest={'binary_sha256':hashlib.sha256(output.read_bytes()).hexdigest(),'inputs':{str(source.relative_to(root)):hashlib.sha256(source.read_bytes()).hexdigest()},'compiler':subprocess.check_output([cc,'--version'],text=True)}
(root/'build/wine-gl-window.build.json').write_text(json.dumps(manifest,indent=2)+'\n')
print(output)
