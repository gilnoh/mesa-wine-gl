#!/usr/bin/env python3
"""Read installed TFA files; emit a static inventory, not a runtime usage claim."""
import collections
import hashlib
import json
from pathlib import Path
import re

root = Path(__file__).resolve().parent.parent
workbench = root.parent / "wine-workbench-macos"
manifest = workbench / "library/SteamLibrary/steamapps/appmanifest_1281220.acf"
text = manifest.read_text()
fields = {key: re.search(r'"' + key + r'"\s+"([^"\r\n]+)"', text).group(1)
          for key in ("appid", "name", "installdir", "buildid")}
game = manifest.parent / "common" / fields["installdir"]
versions = collections.Counter()
compute = []
features = {key: [] for key in ("ssbo", "image_load_store", "atomics", "tessellation", "geometry")}
patterns = {
    "ssbo": r'\bbuffer\s+\w+\s*\{',
    "image_load_store": r'\b(?:imageLoad|imageStore)\s*\(',
    "atomics": r'\b(?:atomic\w+|imageAtomic\w+)\s*\(',
    "tessellation": r'\b(?:gl_TessCoord|gl_TessLevelOuter|gl_TessLevelInner)\b',
    "geometry": r'\b(?:EmitVertex|EndPrimitive)\s*\(',
}
shaders = sorted(game.rglob("*.glsl"))
for path in shaders:
    source = path.read_text(errors="replace")
    relative = str(path.relative_to(game))
    for version in re.findall(r'^\s*#version\s+(\d+)', source, flags=re.M):
        versions[version] += 1
    if re.search(r'layout\s*\([^)]*local_size_[xyz]', source):
        compute.append(relative)
    for name, pattern in patterns.items():
        if re.search(pattern, source):
            features[name].append(relative)
modules = {}
for name in ("TFA.exe", "OgreMain.dll", "RenderSystem_GL3Plus.dll", "OgreGPUTask.dll", "Plankton.dll"):
    path = game / "bin/master" / name
    data = path.read_bytes()
    symbols = sorted({s.decode() for s in re.findall(rb'(?<![A-Za-z0-9_])(?:gl|wgl)[A-Z][A-Za-z0-9_]+(?=\x00)', data)})
    modules[name] = {"sha256": hashlib.sha256(data).hexdigest(), "gl_name_strings": symbols}
print(json.dumps({
    "steam": fields, "game_directory": str(game),
    "method": "Static shader text and DLL strings. Presence does not prove runtime use; absence does not prove non-use.",
    "glsl_file_count": len(shaders), "version_directives": dict(sorted(versions.items())),
    "compute_shader_candidates": compute, "shader_feature_candidates": features,
    "shader_sha256": {str(p.relative_to(game)): hashlib.sha256(p.read_bytes()).hexdigest() for p in shaders},
    "modules": modules,
}, indent=2))
