#!/bin/bash
# Build the pinned, unmodified x86_64 Mesa baseline for Wine/Rosetta.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
if [ "$(uname -m)" != x86_64 ]; then
    exec /usr/bin/arch -x86_64 /bin/bash "$0" "$@"
fi
cd "$ROOT"
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH
unset CFLAGS CXXFLAGS OBJCFLAGS CPPFLAGS LDFLAGS
export PATH="$ROOT/toolchains/python-x86_64/bin:/usr/local/opt/llvm/bin:/usr/local/opt/bison/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"
export PKG_CONFIG_LIBDIR="/usr/local/lib/pkgconfig:/usr/local/share/pkgconfig"
export PKG_CONFIG_PATH="/usr/local/opt/llvm/lib/pkgconfig:/usr/local/opt/spirv-llvm-translator/lib/pkgconfig:/usr/local/opt/spirv-tools/lib/pkgconfig:/usr/local/opt/libclc/share/pkgconfig"
export SDKROOT="$(DEVELOPER_DIR="$(xcode-select -p)" xcrun --sdk macosx --show-sdk-path)"
export MACOSX_DEPLOYMENT_TARGET=26.0
MESON="$ROOT/toolchains/python-x86_64/bin/meson"
[ -x "$MESON" ] || { echo 'Create toolchains/python-x86_64 and install config/python-build-requirements.txt first.' >&2; exit 1; }
want=$(python -c 'import json; print(json.load(open("sources.lock.json"))["mesa"]["commit"])')
[ "$(git -C src/mesa rev-parse HEAD)" = "$want" ] || { echo 'Mesa source revision does not match sources.lock.json' >&2; exit 1; }
[ -z "$(git -C src/mesa status --porcelain --untracked-files=no)" ] || { echo 'Baseline requires unmodified Mesa source' >&2; exit 1; }
mkdir -p build
args=(setup build/mesa-x86_64 src/mesa --native-file config/mesa-x86_64.ini
      --buildtype debugoptimized -Db_ndebug=false
      -Dplatforms=macos -Dgallium-drivers=zink -Dvulkan-drivers=kosmickrisp
      -Dopengl=true -Dglx=disabled -Degl=disabled -Dgbm=disabled
      -Dllvm=enabled -Dzstd=enabled -Dtools=zink)
[ ! -f build/mesa-x86_64/build.ninja ] || args+=(--reconfigure)
"$MESON" "${args[@]}" > build/mesa-configure.log 2>&1 || { tail -40 build/mesa-configure.log; exit 1; }
if [ "${1:-}" = --configure-only ]; then
    tail -30 build/mesa-configure.log
    exit 0
fi
ninja -C build/mesa-x86_64 -j "${JOBS:-6}" > build/mesa-build.log 2>&1 || { tail -60 build/mesa-build.log; exit 1; }
echo 'Mesa build finished. See build/mesa-configure.log and build/mesa-build.log.'
